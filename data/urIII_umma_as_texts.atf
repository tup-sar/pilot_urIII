&P128083 = RO 05, 09 08 
#atf: lang sux 
@tablet 
@obverse 
1. 5(u) la2 1(asz) sze gur 
#tr.en: 49 gur barley, 
2. ku3-bi 1(disz) ma-na 5(disz) 1/3(disz) gin2 
#tr.en: its silver: 1 mina 5 1/3 shekels, 
# calculation: 49 × 1.5 shekels per gur = 65 1/3 
3. a-ra2 1(disz)-kam 
#tr.en: first time; 
4. 2(asz) 2(barig) 3(ban2) sze gur 
#tr.en: 2 gur 2 barig 3 ban2 barley, 
5. ku3-bi 3(disz) gin2 2(u) 2(disz) 1/2(disz) sze 
#tr.en: its silver: 2 shekels 22 1/2 grains 
# calculation: 2.5 × 1.25 shekels per gur = 3 22.5/180 
6. a-ra2 2(disz)-kam 
#tr.en: second time; 
7. 2(u) 2(disz) {gesz}pesz3 sze-er-gu UD-DU-A 
#tr.en: 22 strings of dates, dried(?), 
8. 2(ban2) 6(disz) sila3 {gesz}haszhur hul? 
#tr.en: 2 ban2 6 sila3 crushed crabapples, 
9. ku3-bi 5/6(disz) gin2 la2 2(disz) 1/2(disz) sze 
#tr.en: their silver: 5/6 shekels less 2 1/2 grains; 
# calculation: (22 × 180/30) + (26 × 180/300) = 147.6 grains (text has 147.5) 
10. 2(disz) gin2 ki ur-{d}utu-ta 
#tr.en: 2 shekels from Ur-Utu; 
$ blank space 
11. szunigin 1(disz) ma-na 1(u) 1(disz) gin2 igi-6(disz)-gal2# [2(u) sze] ku3 
#tr.en: total: 1 mina 11 1/6 shekels 20 grains silver; 
@reverse 
1. sza3-bi-ta 
#tr.en: therefrom: 
2. 1(disz) ma-na ku3-babbar 
#tr.en: 1 mina silver 
3. kiszib3 lu2-kal-la ki ur-sila-luh mu-kux(DU)#? 
#tr.en: under seal of Lukalla, delivered from Ur-silaluh; 
4. 2(disz) 1/2(disz) gin2 ku3 esir2 kiszib3 nu-ra-a 
#tr.en: 1 2/1 shekels silver (for) bitumen, unsealed; 
5. 6(disz) gin2 lu2-{d}inanna szu ba-ti 
#tr.en: 6 shekels received by Lu-Inanna; 
$ blank space 
6. szunigin 1(disz) ma-na 8(disz) 1/2(disz) gin2 ku3-babbar 
#tr.en: total: 1 mina 8 1/2 shekels silver; 
7. zi-ga-am3 
8. la2-ia3 2(disz) 2/3(disz) gin2 2(u) sze ku3-babbar 
#tr.en: deficit: 2 2/3 shekels 20 grains silver; 
9. nig2-ka9-ak ur-sila-luh dam-gar3 
#tr.en: account of Ur-silaluh, the trade agent; 
10. egir6 ba-usz2-ta nig2-ka9-bi ba-ak 
#tr.en: after he died, this account was done; 
11. iti diri 
#tr.en: extra month, 
# text moved to next line 
12. mu {d}amar-{d}suen lugal-e ur-bi2-lum{ki} mu-hul 
#tr.en: year: “Amar-Suen the king destroyed Urbilum.” 
 



