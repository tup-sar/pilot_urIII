&P109412 = Georgica 3.07 
#atf: lang sux 
@tablet 
@obverse 
1. 1(bur3) GAN2 gesz-ur3-ra a-ra2 3(disz)-kam 1(esze3) GAN2-ta 
2. a2 erin2-na-bi u4 2(u) 7(disz)-kam 
# calculation: (18 × 3 × 3[erin2/plough]) ÷ 6 = 27 
# ploughmen always 3 erin2, seeding ploughs always 4 erin2: 
# d = (a ÷ b/3) + (a ÷ c/3 x 3/2/1) = (a/b x 3) + ((a/c x 3) x 3/2/1)
# if plough type1 . plough type2, then:
# d = 2(a ÷ b/3) + (a ÷ c/3 x 3/2/1) etc.
3. 2(esze3) 4(iku) GAN2 gesz a-ra2 3(disz)-kam 1(esze3) GAN2-ta 
4. a2 erin2-na-bi u4 1(u) 6(disz)-kam 
# calculation: (16 × 3 × 3) ÷ 6 = 16(?; a-ra2 2!?)) 
5. 2(esze3) 2(iku) GAN2 tug2-gurx(|SZE.KIN|) 1(iku) GAN2-ta 
6. gesz a-ra2 3(disz)-kam 1(esze3) GAN2-ta 
7. a2 erin2-na-bi u4 1(gesz2) 3(disz)-kam 
# calculation: (14 × 3) ÷ 1 + (14 × 3 × 3) ÷ 6 = 63 
8. a2 gesz-ur3-ra 
9. 1(gesz2) 3(u) 5(disz) sar al 5(disz) sar-ta 
10. a2-bi u4 2(u) la2 1(disz@t)-kam 
# calculation: 95 ÷ 5 = 19 
11. 2(u) 4(disz) sar al 4(disz) sar-ta 
@reverse 
1. a2-bi u4 6(disz)-kam 
# calculation: 24 ÷ 4 = 6 
2. a2 sza3-gu4-ka 
3. 1(gesz'u) 3(u) 6(disz) sar al 4(disz) sar-ta 
4. a2-bi u4 2(gesz2) 3(u) 9(disz)#-[kam] 
# calculation: 636 ÷ 4 = 159 (sic, here 9(disz)) 
5. 1(gesz2) 4(u) sar al [2(u) sar-ta] 
6. a2-bi u4 5(disz)-[kam] 
# calculation: 100 ÷ 20 = 5 
7. 3(gesz2) 1(u) sar al 5(disz) sar-ta 
8. a2-bi u4 3(u) 8(disz)-kam 
# calculation: 190 ÷ 5 = 38 
9. a2 lu2 hun-ga2 6(disz) sila3-ta 
10. a-sza3 tur-kin-ag-ga 
11. ugula ur#-mes# lunga# 
12. giri3 a-du-mu u3 ur-mes 
13. kiszib3 lugal-e2-mah-e 
14. mu hu-uh2-nu-ri ba-hul 
@seal 1 
1. lugal-e2-mah-e 
2. dub-sar 
3. dumu lugal-ku3-ga-ni 
 

