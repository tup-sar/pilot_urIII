&P100053 = AAS 065 
#atf: lang sux 
@tablet 
@obverse 
1. [n] gin2 ku3-babbar 
2. [ki] lu2#-kal-la-ta 
$ blank space 
3. sza3-bi-ta 
4. 1(asz) 2(barig) 3(disz) 1/2(disz) sila3 esir2 E2-A gur 
5. ku3-bi 3(disz) 1/2(disz) gin2 5(disz) sze 
# calculation: 435.5 ÷ 3 95/180 = ca. 120 sila3 per shekel 
6. 2(asz) 4(barig) 1(ban2) 1(disz) sila3 naga si-e3 gur 
7. ku3-bi 1(disz) gin2 la2 1(u) sze 
# calculation: 851 ÷ 170/180 = ca. 900 sila3 per shekel 
8. 1(u) 2(asz) gu2 3(u) ma-na im-babbar2 
9. ku3-bi 5/6(disz) gin2 
# calculation: 750 ÷ 5/6 = 900 mana per shekel 
10. 2(ban2) 3(disz) 2/3(disz) sila3 zi3 gu2-gal 
11. ku3-bi 1/3(disz) gin2 2(u) sze 
# calculation: 23 2/3 ÷ 80/180 = ca. 53 sila3 per shekel 
12. 9(disz) 1/2(disz) ma-na igi-esir2? 
13. ku3-bi 1(u) 4(disz) sze 
14. 8(disz) 1/2(disz) ma-na esir2 had2 
15. ku3-bi 3(disz) sze 
16. 1(u) 2(disz) {gesz}kab2-kul 
@reverse 
1. ku3-bi 1(disz) gin2 
$ blank space 
2. szunigin 6(disz) 5/6(disz) gin2 2(disz) sze ku3-babbar 
3. zi-ga-am3 
$ blank space 
4. nig2-ka9-ak dam-gar3 sza3 bala-a 
5. giri3# a-gu 
6. [mu] en eridu{ki} ba-hun 

&P100068 = AAS 081 
