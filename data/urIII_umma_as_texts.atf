#tr.en: orchards surveyed, 
4. {gesz}geszimmar szid-da 
#tr.en: date palms counted, 
5. e2 {d}szara2 
#tr.en: house of Šara; 
6. e2 {d}nin-ur4-ra 
#tr.en: house of Ninura; 
7. e2 {d}szul-gi-ra 
#tr.en: house of Šulgi; 
8. {gesz}kiri6 apin-la2 
#tr.en: orchards of ..., 
@reverse 
