3. 1(gesz'u) 8(gesz2) gur sze ur5-ra sila gal2-la 
4. giri3 a-da-ga 
5. im e2 szu-szum2-ma-ke4 tak4-a 
6. szunigin 4(gesz'u) 3(gesz2) 3(u) 1(barig) 4(ban2) [sze gur] 
7. sza3-bi-[ta] 
8. 2(asz) 2(barig) 3(ban2) gur sa2-du11 ensi2# 
9. 5(asz) gur nin 
10. 1(asz) 1(barig) gur di4-di4-la? [...] 
11. 3(u) 1(asz) 3(barig) 1(ban2) 5(disz) sila3 [gur] 
12. sze-ba geme2 ARAD2 ensi2-[ka] 
13. 1(asz) 1(barig) 5(disz) sila3 gur 
14. sze-ba geme2 ARAD2 di4-[di4-la ...] 
15. iti 1(disz)-a-kam iti [1(u) 2(disz)-sze3] 
16. [sze]-bi 8(gesz2) 1(u) 8(asz)# [3(barig) gur] 
$ rest broken 
@reverse 
1. [...] 2(u) gur [...] 
2. mu en [{d}nanna ga-esz{ki} ba-hun] 
3. 7(gesz2) 2(u) 9(asz) 2(barig) [x gur ...] 
4. mu {d}szu-{d}suen [lugal] 
5. 1(gesz2) 4(u) gur mu ma2 [{d}en-ki-ka] ba-ab-[du8] 
6. ugu2 ka-guru7 ba-[a-gar] 
7. szunigin 3(gesz'u) 3(gesz2) 2(u) 8(asz) 3(barig) 4(ban2) [3(disz) sila3] sze gur 
8. zi-ga-am3 
9. la2-ia3 1(gesz'u) 1(asz) 2(barig) 5(ban2) 7(disz) sila3 sze gur 
10. nig2-ka9-ak sze e2-du6-la [(x)] ur-{d}li9-si4 ensi2-ka 
11. iti {d}dumu-zi 
# some text moved to next line 
12. mu en eridu{ki} ba-hun-ta 
13. mu ma2 {d}en-ki-ka ba-ab-du8-sze3 
 

